{
  "collectionName": "components_blocks_videos",
  "info": {
    "displayName": "Video",
    "description": "Video embed block (direct or Vimeo)"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "enum": ["direct", "vimeo"],
      "default": "direct",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 500
    },
    "aspectRatio": {
      "type": "enumeration",
      "enum": ["16:9", "4:3", "1:1"],
      "default": "16:9"
    }
  }
}
