{
  "name": "presents",
  "version": "2.0.0",
  "private": true,
  "description": "Enhanced linkhub/linktree alternative with Next.js and Strapi CMS",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @presents/web dev",
    "dev:cms": "pnpm --filter @presents/cms develop",
    "build": "pnpm run --parallel build",
    "build:web": "pnpm --filter @presents/web build",
    "build:cms": "pnpm --filter @presents/cms build",
    "lint": "pnpm run --parallel lint",
    "lint:web": "pnpm --filter @presents/web lint",
    "clean": "pnpm run --parallel clean"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
